#!/bin/bash
set -Eeuo pipefail
umask 077
export LC_ALL=C
export PATH='/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin'

readonly ENTRY_PATH='/usr/local/sbin/qimao-application-release'
readonly DECLARATION_TOOL='/usr/local/libexec/qimao-application-release-declaration.mjs'
readonly FIXED_INBOUND='/var/tmp/qimao-application-release-inbound'
readonly DECLARATION_NAME='application-release.declaration.json'
readonly CHECKSUMS_NAME='SHA256SUMS'
readonly LOCK_FILE='/run/lock/qimao-application-release.lock'
readonly RUNTIME='/run/qimao-application-release'
readonly CURRENT='/opt/qimao-terms-cloud/current'
readonly STATIC_LINK='/srv/qimao-terms-cloud/frontend'
readonly SYSTEM_STATIC_LINK='/srv/qimao-terms-cloud/system-frontend'
readonly CURRENT_NEXT='/opt/qimao-terms-cloud/current.application-release.next'
readonly STATIC_NEXT='/srv/qimao-terms-cloud/frontend.application-release.next'
readonly SYSTEM_STATIC_NEXT='/srv/qimao-terms-cloud/system-frontend.application-release.next'
readonly BACKEND_UNIT='qimao-backend.service'
readonly ASR_UNIT='qimao-worker@asr.worker.entry.js.service'
readonly SCREEN_UNIT='qimao-worker@screen-text.worker.entry.js.service'
readonly OPENVINO_UNIT='qimao-local-ocr-openvino.service'

probe_status_allowed() {
  case "$1" in
    401|403) return 0 ;;
    *) return 1 ;;
  esac
}

probe_status_matches() {
  probe_status_allowed "$1" && [ "$1" = "$2" ]
}

employee_static_mode_allowed() {
  case "$1" in
    replace|preserve) return 0 ;;
    *) return 1 ;;
  esac
}

system_static_mode_allowed() {
  case "$1" in
    replace|preserve) return 0 ;;
    *) return 1 ;;
  esac
}

employee_static_preserve_guard() {
  local mode="$1" expected="$2" stage="$3" link="$4" next="$5"
  if [ "$mode" = 'replace' ]; then return 0; fi
  [ "$mode" = 'preserve' ] \
    && [ "$(readlink -f "$link" 2>/dev/null || true)" = "$expected" ] \
    && [ ! -e "$stage" ] && [ ! -L "$stage" ] \
    && [ ! -e "$next" ] && [ ! -L "$next" ]
}

employee_static_finalize() {
  local mode="$1" expected="$2" stage="$3" new="$4" link="$5" next="$6"
  case "$mode" in
    replace)
      static_created=1
      mv -T "$stage" "$new"
      static_stage_created=0
      ;;
    preserve)
      employee_static_preserve_guard "$mode" "$expected" "$stage" "$link" "$next"
      ;;
    *) return 1 ;;
  esac
}

employee_static_switch() {
  local mode="$1" expected="$2" stage="$3" new="$4" link="$5" next="$6"
  case "$mode" in
    replace)
      ln -s "$new" "$next"
      static_switched=1
      mv -Tf "$next" "$link"
      ;;
    preserve)
      employee_static_preserve_guard "$mode" "$expected" "$stage" "$link" "$next"
      ;;
    *) return 1 ;;
  esac
}

system_static_preserve_guard() {
  local mode="$1" expected="$2" stage="$3" new="$4" link="$5" next="$6"
  if [ "$mode" = 'replace' ]; then return 0; fi
  [ "$mode" = 'preserve' ] \
    && [ "$(readlink -f "$link" 2>/dev/null || true)" = "$expected" ] \
    && [ ! -e "$stage" ] && [ ! -L "$stage" ] \
    && { [ "$new" = "$expected" ] || { [ ! -e "$new" ] && [ ! -L "$new" ]; }; } \
    && [ ! -e "$next" ] && [ ! -L "$next" ]
}

system_static_finalize() {
  local mode="$1" expected="$2" stage="$3" new="$4" link="$5" next="$6"
  case "$mode" in
    replace)
      system_static_created=1
      mv -T "$stage" "$new"
      system_static_stage_created=0
      ;;
    preserve)
      system_static_preserve_guard "$mode" "$expected" "$stage" "$new" "$link" "$next"
      ;;
    *) return 1 ;;
  esac
}

system_static_switch() {
  local mode="$1" expected="$2" stage="$3" new="$4" link="$5" next="$6"
  case "$mode" in
    replace)
      ln -s "$new" "$next"
      system_static_switched=1
      mv -Tf "$next" "$link"
      ;;
    preserve)
      system_static_preserve_guard "$mode" "$expected" "$stage" "$new" "$link" "$next"
      ;;
    *) return 1 ;;
  esac
}

runner_self_test() {
  probe_status_allowed 401
  probe_status_allowed 403
  if probe_status_allowed 400 || probe_status_allowed 404 || probe_status_allowed 500; then return 1; fi
  probe_status_matches 401 401
  probe_status_matches 403 403
  if probe_status_matches 401 403 || probe_status_matches 403 401; then return 1; fi
  employee_static_mode_allowed replace
  employee_static_mode_allowed preserve
  if employee_static_mode_allowed keep || employee_static_mode_allowed drop; then return 1; fi
  system_static_mode_allowed replace
  system_static_mode_allowed preserve
  if system_static_mode_allowed keep || system_static_mode_allowed drop; then return 1; fi
  (
    fixture_root="$(mktemp -d)"
    trap 'rm -rf -- "$fixture_root"' EXIT
    old="$fixture_root/old"
    foreign="$fixture_root/foreign"
    link="$fixture_root/frontend"
    next="$fixture_root/frontend.next"
    stage="$fixture_root/frontend.stage"
    new="$fixture_root/frontend-new"
    mkdir "$old" "$foreign"
    ln -s "$old" "$link"
    expected="$(readlink -f "$old")"
    before="$(readlink -f "$link")"
    static_created=0
    static_stage_created=0
    static_switched=0
    employee_static_finalize preserve "$expected" "$stage" "$expected" "$link" "$next"
    employee_static_switch preserve "$expected" "$stage" "$expected" "$link" "$next"
    employee_static_preserve_guard preserve "$expected" "$stage" "$link" "$next"
    [ "$(readlink -f "$link")" = "$before" ]
    [ "$static_created/$static_stage_created/$static_switched" = '0/0/0' ]
    [ ! -e "$stage" ] && [ ! -L "$stage" ] && [ ! -e "$next" ] && [ ! -L "$next" ]
    rm -f "$link"
    ln -s "$foreign" "$link"
    if employee_static_preserve_guard preserve "$expected" "$stage" "$link" "$next"; then return 1; fi
    rm -f "$link"
    ln -s "$old" "$link"
    mkdir "$stage"
    static_created=0
    static_stage_created=1
    static_switched=0
    employee_static_finalize replace "$expected" "$stage" "$new" "$link" "$next"
    [ -d "$new" ] && [ ! -e "$stage" ] && [ "$static_created/$static_stage_created" = '1/0' ]
    employee_static_switch replace "$expected" "$stage" "$new" "$link" "$next"
    [ "$(readlink -f "$link")" = "$(readlink -f "$new")" ]
    [ ! -e "$next" ] && [ ! -L "$next" ] && [ "$static_switched" = '1' ]
    system_old="$fixture_root/system-old"
    system_foreign="$fixture_root/system-foreign"
    system_link="$fixture_root/system-frontend"
    system_next="$fixture_root/system-frontend.next"
    system_stage="$fixture_root/system-frontend.stage"
    system_new="$fixture_root/system-frontend-new"
    mkdir "$system_old" "$system_foreign"
    ln -s "$system_old" "$system_link"
    system_expected="$(readlink -f "$system_old")"
    system_before="$(readlink -f "$system_link")"
    system_static_created=0
    system_static_stage_created=0
    system_static_switched=0
    system_static_finalize preserve "$system_expected" "$system_stage" "$system_new" "$system_link" "$system_next"
    system_static_switch preserve "$system_expected" "$system_stage" "$system_new" "$system_link" "$system_next"
    system_static_preserve_guard preserve "$system_expected" "$system_stage" "$system_new" "$system_link" "$system_next"
    [ "$(readlink -f "$system_link")" = "$system_before" ]
    [ "$system_static_created/$system_static_stage_created/$system_static_switched" = '0/0/0' ]
    [ ! -e "$system_stage" ] && [ ! -L "$system_stage" ]
    [ ! -e "$system_new" ] && [ ! -L "$system_new" ]
    [ ! -e "$system_next" ] && [ ! -L "$system_next" ]
    rm -f "$system_link"
    ln -s "$system_foreign" "$system_link"
    if system_static_preserve_guard preserve "$system_expected" "$system_stage" "$system_new" "$system_link" "$system_next"; then return 1; fi
  )
  printf '%s\n' 'runner_self_test=passed cases=28 statuses=401,403 employee=replace,preserve system_static=replace,preserve preserve_rollback=guarded'
}

if [ "${1-}" = '--self-test' ] && [ "$#" -eq 1 ]; then
  runner_self_test
  exit 0
fi

input_fail() {
  echo "terminal=blocked code=$1 effects=0 inbound=retained"
  exit 64
}

inbound="${1-}"
[ "$EUID" -eq 0 ] || input_fail 'ROOT_REQUIRED'
[ "$#" -eq 1 ] || input_fail 'ARGUMENT_COUNT_INVALID'
[ "$inbound" = "$FIXED_INBOUND" ] || input_fail 'INBOUND_PATH_INVALID'
[ "$(readlink -f -- "${BASH_SOURCE[0]}")" = "$ENTRY_PATH" ] || input_fail 'ENTRY_PATH_INVALID'
[ -f "$ENTRY_PATH" ] && [ ! -L "$ENTRY_PATH" ] || input_fail 'ENTRY_FILE_INVALID'
[ -f "$DECLARATION_TOOL" ] && [ ! -L "$DECLARATION_TOOL" ] || input_fail 'DECLARATION_TOOL_INVALID'
[ "$(stat -c '%U:%G:%a' "$ENTRY_PATH")" = 'root:root:750' ] || input_fail 'ENTRY_IDENTITY_INVALID'
[ "$(stat -c '%U:%G:%a' "$DECLARATION_TOOL")" = 'root:root:750' ] || input_fail 'DECLARATION_TOOL_IDENTITY_INVALID'

for tool in \
  /bin/bash \
  /usr/local/bin/node \
  /usr/bin/awk \
  /usr/bin/base64 \
  /usr/bin/chmod \
  /usr/bin/chown \
  /usr/bin/cmp \
  /usr/bin/cp \
  /usr/bin/curl \
  /usr/bin/find \
  /usr/bin/flock \
  /usr/bin/grep \
  /usr/bin/install \
  /usr/bin/ln \
  /usr/bin/mkdir \
  /usr/bin/mktemp \
  /usr/bin/mv \
  /usr/bin/python3 \
  /usr/bin/readlink \
  /usr/bin/rm \
  /usr/bin/rmdir \
  /usr/sbin/runuser \
  /usr/bin/seq \
  /usr/bin/sha256sum \
  /usr/bin/sleep \
  /usr/bin/sort \
  /usr/bin/stat \
  /usr/bin/systemctl \
  /usr/bin/systemd-run \
  /usr/bin/tar \
  /usr/bin/test \
  /usr/bin/uniq \
  /usr/bin/wc; do
  [ -x "$tool" ] || input_fail 'FIXED_TOOL_MISSING'
done

[ -d "$inbound" ] && [ ! -L "$inbound" ] || input_fail 'INBOUND_DIRECTORY_INVALID'
[ "$(stat -c '%U:%G:%a' "$inbound")" = 'qimao-deploy:qimao-deploy:700' ] \
  || input_fail 'INBOUND_DIRECTORY_IDENTITY_INVALID'
inbound_file_count="$(find "$inbound" -mindepth 1 -maxdepth 1 -type f | wc -l)"
case "$inbound_file_count" in
  3|4) ;;
  *) input_fail 'INBOUND_FILE_COUNT_INVALID' ;;
esac
[ "$(find "$inbound" -mindepth 1 -maxdepth 1 ! -type f | wc -l)" = '0' ] \
  || input_fail 'INBOUND_NONFILE_INVALID'
declaration_source="$inbound/$DECLARATION_NAME"
checksums_source="$inbound/$CHECKSUMS_NAME"
for file in "$declaration_source" "$checksums_source"; do
  [ -f "$file" ] && [ ! -L "$file" ] || input_fail 'INBOUND_CONTROL_FILE_INVALID'
  [ "$(stat -c '%U:%G:%h' "$file")" = 'qimao-deploy:qimao-deploy:1' ] \
    || input_fail 'INBOUND_CONTROL_FILE_IDENTITY_INVALID'
done

exec 9>"$LOCK_FILE"
flock -n 9 || input_fail 'LOCK_ALREADY_HELD'
[ ! -e "$RUNTIME" ] || input_fail 'RUNTIME_ALREADY_PRESENT'
install -d -o root -g root -m 0700 "$RUNTIME"
runtime_created=1

preclaim_fail() {
  local code="$1" cleanup='passed'
  if [ "$runtime_created" -eq 1 ] && [ -e "$RUNTIME" ]; then
    rm -rf --one-file-system -- "$RUNTIME" || cleanup='failed'
  fi
  echo "terminal=blocked code=$code effects=0 inbound=retained cleanup=$cleanup"
  exit 64
}

trap 'preclaim_fail PRECLAIM_FAILED' ERR
trap 'preclaim_fail SIGNAL_INT' INT
trap 'preclaim_fail SIGNAL_TERM' TERM

values_file="$RUNTIME/declaration.values"
if ! /usr/local/bin/node "$DECLARATION_TOOL" --emit "$declaration_source" > "$values_file"; then
  preclaim_fail 'DECLARATION_INVALID'
fi

release_id=''
declaration_schema=''
archive_name=''
old_release=''
new_release=''
old_static=''
new_static=''
employee_static_mode=''
system_static_enabled=''
system_static_mode=''
old_system_static=''
new_system_static=''
asr_expected_state=''
screen_expected_state=''
openvino_expected_state=''
probe_label=''
probe_path=''
probe_expected_status=''
migration_mode=''
migration_helper=''
migration_schema=''
declare -a static_markers=()
declare -a system_static_markers=()
field_count=0
while IFS=$'\t' read -r key encoded; do
  if ! decoded="$(printf '%s' "$encoded" | base64 --decode)"; then
    preclaim_fail 'DECLARATION_EMIT_INVALID'
  fi
  case "$key" in
    schema) declaration_schema="$decoded" ;;
    release_id) release_id="$decoded" ;;
    archive_name) archive_name="$decoded" ;;
    previous_backend) old_release="$decoded" ;;
    next_backend) new_release="$decoded" ;;
    previous_static) old_static="$decoded" ;;
    next_static) new_static="$decoded" ;;
    employee_static_mode) employee_static_mode="$decoded" ;;
    system_static_enabled) system_static_enabled="$decoded" ;;
    system_static_mode) system_static_mode="$decoded" ;;
    previous_system_static) old_system_static="$decoded" ;;
    next_system_static) new_system_static="$decoded" ;;
    asr_expected_state) asr_expected_state="$decoded" ;;
    screen_expected_state) screen_expected_state="$decoded" ;;
    openvino_expected_state) openvino_expected_state="$decoded" ;;
    probe_label) probe_label="$decoded" ;;
    probe_path) probe_path="$decoded" ;;
    probe_expected_status) probe_expected_status="$decoded" ;;
    migration_mode) migration_mode="$decoded" ;;
    migration_helper) migration_helper="$decoded" ;;
    migration_schema) migration_schema="$decoded" ;;
    static_marker) static_markers+=("$decoded") ;;
    system_static_marker) system_static_markers+=("$decoded") ;;
    *) preclaim_fail 'DECLARATION_EMIT_KEY_INVALID' ;;
  esac
  field_count=$((field_count + 1))
done < "$values_file"

[ "$field_count" -eq $((21 + ${#static_markers[@]} + ${#system_static_markers[@]})) ] \
  || preclaim_fail 'DECLARATION_EMIT_COUNT_INVALID'
[ "$declaration_schema" = 'qimao.application-release/v1' ] \
  || [ "$declaration_schema" = 'qimao.application-release/v2' ] \
  || preclaim_fail 'DECLARATION_EMIT_SCHEMA_INVALID'
[ -n "$release_id" ] && [ -n "$archive_name" ] || preclaim_fail 'DECLARATION_EMIT_REQUIRED_INVALID'
[ -n "$old_release" ] && [ -n "$new_release" ] || preclaim_fail 'DECLARATION_EMIT_REQUIRED_INVALID'
[ -n "$old_static" ] && [ -n "$new_static" ] || preclaim_fail 'DECLARATION_EMIT_REQUIRED_INVALID'
[ -n "$asr_expected_state" ] && [ -n "$screen_expected_state" ] && [ -n "$openvino_expected_state" ] \
  || preclaim_fail 'DECLARATION_EMIT_REQUIRED_INVALID'
[ -n "$probe_label" ] && [ -n "$probe_path" ] && probe_status_allowed "$probe_expected_status" \
  || preclaim_fail 'DECLARATION_EMIT_REQUIRED_INVALID'
case "$employee_static_mode" in
  replace)
    [ "$old_static" != "$new_static" ] && [ "${#static_markers[@]}" -ge 1 ] \
      || preclaim_fail 'DECLARATION_EMIT_EMPLOYEE_STATIC_INVALID'
    ;;
  preserve)
    [ "$declaration_schema" = 'qimao.application-release/v2' ] \
      && [ "$old_static" = "$new_static" ] \
      && [ "${#static_markers[@]}" -eq 0 ] \
      || preclaim_fail 'DECLARATION_EMIT_EMPLOYEE_STATIC_INVALID'
    ;;
  *) preclaim_fail 'DECLARATION_EMIT_EMPLOYEE_STATIC_INVALID' ;;
esac
case "$system_static_enabled:$system_static_mode" in
  false:replace)
    [ "$declaration_schema" = 'qimao.application-release/v1' ] \
      && [ -z "$old_system_static" ] && [ -z "$new_system_static" ] \
      && [ "${#system_static_markers[@]}" -eq 0 ] \
      || preclaim_fail 'DECLARATION_EMIT_SYSTEM_STATIC_INVALID'
    ;;
  true:replace)
    [ "$declaration_schema" = 'qimao.application-release/v2' ] \
      && [ -n "$old_system_static" ] && [ -n "$new_system_static" ] \
      && [ "$old_system_static" != "$new_system_static" ] \
      && [ "${#system_static_markers[@]}" -ge 1 ] \
      || preclaim_fail 'DECLARATION_EMIT_SYSTEM_STATIC_INVALID'
    ;;
  true:preserve)
    [ "$declaration_schema" = 'qimao.application-release/v2' ] \
      && [ -n "$old_system_static" ] && [ "$old_system_static" = "$new_system_static" ] \
      && [ "${#system_static_markers[@]}" -eq 0 ] \
      || preclaim_fail 'DECLARATION_EMIT_SYSTEM_STATIC_INVALID'
    ;;
  *) preclaim_fail 'DECLARATION_EMIT_SYSTEM_STATIC_INVALID' ;;
esac
if [ "$employee_static_mode" = 'preserve' ] && [ "$system_static_enabled" != 'true' ]; then
  preclaim_fail 'DECLARATION_EMIT_EMPLOYEE_STATIC_INVALID'
fi
case "$migration_mode" in
  none)
    [ -z "$migration_helper" ] && [ -z "$migration_schema" ] \
      || preclaim_fail 'DECLARATION_EMIT_MIGRATION_INVALID'
    ;;
  gated)
    [ "$migration_helper" = 'db-migration-gate.mjs' ] && [ -n "$migration_schema" ] \
      || preclaim_fail 'DECLARATION_EMIT_MIGRATION_INVALID'
    ;;
  *) preclaim_fail 'DECLARATION_EMIT_MIGRATION_INVALID' ;;
esac

archive_source="$inbound/$archive_name"
helper_source=''
if [ "$migration_mode" = 'gated' ]; then
  helper_source="$inbound/$migration_helper"
fi
expected_files="$RUNTIME/expected.files"
actual_files="$RUNTIME/actual.files"
{
  printf '%s\n' "$CHECKSUMS_NAME" "$DECLARATION_NAME" "$archive_name"
  if [ "$migration_mode" = 'gated' ]; then printf '%s\n' "$migration_helper"; fi
} | sort > "$expected_files"
find "$inbound" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | sort > "$actual_files"
cmp -s "$expected_files" "$actual_files" || preclaim_fail 'INBOUND_FILE_SET_INVALID'

declare -a payload_sources=("$declaration_source" "$archive_source" "$checksums_source")
if [ "$migration_mode" = 'gated' ]; then payload_sources+=("$helper_source"); fi
for file in "${payload_sources[@]}"; do
  [ -f "$file" ] && [ ! -L "$file" ] || preclaim_fail 'INBOUND_FILE_INVALID'
  [ "$(stat -c '%U:%G:%h' "$file")" = 'qimao-deploy:qimao-deploy:1' ] \
    || preclaim_fail 'INBOUND_FILE_IDENTITY_INVALID'
done

release_stage="/opt/qimao-terms-cloud/releases/.${release_id}.stage"
static_stage="/srv/qimao-terms-cloud/.frontend-${release_id}.stage"
system_static_stage="/srv/qimao-terms-cloud/.system-frontend-${release_id}.stage"
unpack="$RUNTIME/unpack"
archive_list="$RUNTIME/archive.list"
duplicate_list="$RUNTIME/archive.duplicates"
api_headers="$RUNTIME/api.headers"
api_body="$RUNTIME/api.body"

failure_code='UNEXPECTED_FAILURE'
exact_file_set=1
release_stage_created=0
static_stage_created=0
system_static_stage_created=0
release_created=0
static_created=0
system_static_created=0
backend_switched=0
static_switched=0
system_static_switched=0
backend_restart_attempted=0
migration_attempted=0
schema_retained='none'

safe_remove() {
  case "$1" in
    "$RUNTIME"|"$release_stage"|"$new_release"|"$system_static_stage"|"$new_system_static")
      rm -rf --one-file-system -- "$1" ;;
    "$static_stage"|"$new_static")
      [ "$employee_static_mode" = 'replace' ] || return 1
      rm -rf --one-file-system -- "$1" ;;
    *)
      echo 'cleanup_refused=unsafe_path'
      return 1 ;;
  esac
}

cleanup_inbound() {
  [ "$exact_file_set" -eq 1 ] || return 1
  [ -e "$inbound" ] || return 0
  chmod 0700 "$inbound"
  rm -f -- "${payload_sources[@]}"
  rmdir -- "$inbound"
}

health_wait() {
  local attempt
  for attempt in $(seq 1 30); do
    if [ "$(curl --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' \
      http://127.0.0.1:3001/health 2>/dev/null || true)" = '200' ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

service_state() {
  local unit="$1"
  printf '%s/%s/%s/%s' \
    "$(systemctl show "$unit" -p ActiveState --value)" \
    "$(systemctl show "$unit" -p SubState --value)" \
    "$(systemctl show "$unit" -p NRestarts --value)" \
    "$(systemctl show "$unit" -p ExecMainStatus --value)"
}

service_main_pid() {
  systemctl show "$1" -p MainPID --value
}

restore_link() {
  local link="$1" target="$2" next="$3"
  rm -f -- "$next"
  ln -s "$target" "$next"
  mv -Tf "$next" "$link"
}

rollback() {
  local rc="${1:-1}" cleanup_failed=0
  trap - ERR EXIT INT TERM
  set +e
  if [ "$employee_static_mode" = 'preserve' ]; then
    employee_static_preserve_guard preserve "$old_static" "$static_stage" "$STATIC_LINK" "$STATIC_NEXT" \
      || cleanup_failed=1
  fi
  if [ "$backend_switched" -eq 1 ]; then
    if [ "$(readlink -f "$CURRENT" 2>/dev/null || true)" = "$new_release" ]; then
      restore_link "$CURRENT" "$old_release" "$CURRENT_NEXT" || cleanup_failed=1
    elif [ "$(readlink -f "$CURRENT" 2>/dev/null || true)" != "$old_release" ]; then
      cleanup_failed=1
    fi
  fi
  if [ "$static_switched" -eq 1 ]; then
    if [ "$(readlink -f "$STATIC_LINK" 2>/dev/null || true)" = "$new_static" ]; then
      restore_link "$STATIC_LINK" "$old_static" "$STATIC_NEXT" || cleanup_failed=1
    elif [ "$(readlink -f "$STATIC_LINK" 2>/dev/null || true)" != "$old_static" ]; then
      cleanup_failed=1
    fi
  fi
  if [ "$system_static_switched" -eq 1 ]; then
    if [ "$(readlink -f "$SYSTEM_STATIC_LINK" 2>/dev/null || true)" = "$new_system_static" ]; then
      restore_link "$SYSTEM_STATIC_LINK" "$old_system_static" "$SYSTEM_STATIC_NEXT" || cleanup_failed=1
    elif [ "$(readlink -f "$SYSTEM_STATIC_LINK" 2>/dev/null || true)" != "$old_system_static" ]; then
      cleanup_failed=1
    fi
  fi
  if [ "$system_static_mode" = 'preserve' ]; then
    system_static_preserve_guard preserve "$old_system_static" "$system_static_stage" "$new_system_static" "$SYSTEM_STATIC_LINK" "$SYSTEM_STATIC_NEXT" \
      || cleanup_failed=1
  fi
  rm -f -- "$CURRENT_NEXT" "$SYSTEM_STATIC_NEXT"
  if [ "$employee_static_mode" = 'replace' ]; then
    rm -f -- "$STATIC_NEXT"
  elif ! employee_static_preserve_guard preserve "$old_static" "$static_stage" "$STATIC_LINK" "$STATIC_NEXT"; then
    cleanup_failed=1
  fi
  if [ "$backend_restart_attempted" -eq 1 ]; then
    systemctl restart "$BACKEND_UNIT" || cleanup_failed=1
    health_wait || cleanup_failed=1
  fi
  if [ "$release_stage_created" -eq 1 ] && [ -e "$release_stage" ]; then
    safe_remove "$release_stage" || cleanup_failed=1
  fi
  if [ "$static_stage_created" -eq 1 ] && [ -e "$static_stage" ]; then
    safe_remove "$static_stage" || cleanup_failed=1
  fi
  if [ "$system_static_stage_created" -eq 1 ] && [ -e "$system_static_stage" ]; then
    safe_remove "$system_static_stage" || cleanup_failed=1
  fi
  if [ "$release_created" -eq 1 ] && [ -e "$new_release" ]; then
    [ "$(readlink -f "$CURRENT" 2>/dev/null || true)" = "$old_release" ] \
      && safe_remove "$new_release" || cleanup_failed=1
  fi
  if [ "$static_created" -eq 1 ] && [ -e "$new_static" ]; then
    [ "$(readlink -f "$STATIC_LINK" 2>/dev/null || true)" = "$old_static" ] \
      && safe_remove "$new_static" || cleanup_failed=1
  fi
  if [ "$system_static_created" -eq 1 ] && [ -e "$new_system_static" ]; then
    [ "$(readlink -f "$SYSTEM_STATIC_LINK" 2>/dev/null || true)" = "$old_system_static" ] \
      && safe_remove "$new_system_static" || cleanup_failed=1
  fi
  if [ "$employee_static_mode" = 'preserve' ]; then
    employee_static_preserve_guard preserve "$old_static" "$static_stage" "$STATIC_LINK" "$STATIC_NEXT" \
      || cleanup_failed=1
  fi
  if [ "$system_static_mode" = 'preserve' ]; then
    system_static_preserve_guard preserve "$old_system_static" "$system_static_stage" "$new_system_static" "$SYSTEM_STATIC_LINK" "$SYSTEM_STATIC_NEXT" \
      || cleanup_failed=1
  fi
  if [ "$runtime_created" -eq 1 ] && [ -e "$RUNTIME" ]; then
    safe_remove "$RUNTIME" || cleanup_failed=1
  fi
  cleanup_inbound || cleanup_failed=1
  if [ "$cleanup_failed" -eq 0 ]; then
    echo "terminal=blocked code=$failure_code rollback=passed cleanup=passed migration_attempted:$migration_attempted schema_retained:$schema_retained"
  else
    echo "terminal=blocked code=$failure_code rollback_or_cleanup=failed migration_attempted:$migration_attempted schema_retained:$schema_retained"
  fi
  exit "$rc"
}

trap 'rc=$?; failure_code="${failure_code:-UNEXPECTED_FAILURE}"; rollback "$rc"' ERR
