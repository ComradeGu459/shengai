archive_audit_output="$(
/usr/bin/python3 - "$archive_source" "$system_static_enabled" "$system_static_mode" "$employee_static_mode" <<'PY'
# APPLICATION_RELEASE_ARCHIVE_GATE_BEGIN
import posixpath
import sys
import tarfile


class ArchiveGate(Exception):
    pass


def fail(code):
    raise ArchiveGate(code)


if len(sys.argv) != 5 or sys.argv[2] not in ("true", "false") \
        or sys.argv[3] not in ("replace", "preserve") \
        or sys.argv[4] not in ("replace", "preserve"):
    fail("ARCHIVE_MODE_INVALID")
EXPECTED_ROOTS = {"backend"}
if sys.argv[4] == "replace":
    EXPECTED_ROOTS.add("static")
if sys.argv[2] == "true" and sys.argv[3] == "replace":
    EXPECTED_ROOTS.add("system-static")


def has_control(value):
    return any(ord(character) < 32 or ord(character) == 127 for character in value)


def normalize_member(value):
    name = value.rstrip("/")
    if not name or name.startswith("/") or "\\" in name or has_control(name):
        fail("MEMBER_PATH_INVALID")
    parts = name.split("/")
    if any(part in ("", ".", "..") for part in parts):
        fail("MEMBER_PATH_INVALID")
    if parts[0] not in EXPECTED_ROOTS:
        fail("MEMBER_TOP_LEVEL_INVALID")
    return name


def normalize_link(source, value, hardlink=False):
    if not value or value.startswith("/") or "\\" in value or has_control(value):
        fail("LINK_TARGET_INVALID")
    base = "" if hardlink else posixpath.dirname(source)
    target = posixpath.normpath(posixpath.join(base, value))
    if target in ("", ".", "..") or target.startswith("../") or target.startswith("/"):
        fail("LINK_TARGET_ESCAPE")
    if target.split("/", 1)[0] != source.split("/", 1)[0]:
        fail("LINK_TARGET_CROSS_ROOT")
    return target.rstrip("/")


try:
    with tarfile.open(sys.argv[1], "r:gz") as archive:
        members = archive.getmembers()
    if not members:
        fail("ARCHIVE_EMPTY")
    names = [normalize_member(member.name) for member in members]
    if len(names) != len(set(names)):
        fail("MEMBER_DUPLICATE")
    if {name.split("/", 1)[0] for name in names} != EXPECTED_ROOTS:
        fail("TOP_LEVEL_SET_INVALID")
    name_set = set(names)
    counts = {"regular": 0, "directory": 0, "symlink": 0, "hardlink": 0}
    for member, name in zip(members, names):
        if member.isfile():
            counts["regular"] += 1
        elif member.isdir():
            counts["directory"] += 1
        elif member.issym():
            counts["symlink"] += 1
            if normalize_link(name, member.linkname) not in name_set:
                fail("SYMLINK_TARGET_MISSING")
        elif member.islnk():
            counts["hardlink"] += 1
            if normalize_link(name, member.linkname, hardlink=True) not in name_set:
                fail("HARDLINK_TARGET_MISSING")
        else:
            fail("MEMBER_TYPE_INVALID")
    print(
        "archive_audit=passed"
        f" members:{len(members)}"
        f" regular:{counts['regular']}"
        f" directories:{counts['directory']}"
        f" symlinks:{counts['symlink']}"
        f" hardlinks:{counts['hardlink']}"
    )
except ArchiveGate as error:
    print(f"archive_audit=blocked code={error}", file=sys.stderr)
    raise SystemExit(1)
except Exception:
    print("archive_audit=blocked code=ARCHIVE_READ_INVALID", file=sys.stderr)
    raise SystemExit(1)
# APPLICATION_RELEASE_ARCHIVE_GATE_END
PY
)"
echo "$archive_audit_output"
tar -tzf "$archive_source" > "$archive_list"
[ -s "$archive_list" ]
if [ "$employee_static_mode" = 'preserve' ] && [ "$system_static_mode" = 'preserve' ]; then
