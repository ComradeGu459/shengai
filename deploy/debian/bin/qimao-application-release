elif [ "$employee_static_mode" = 'preserve' ] && [ "$system_static_mode" = 'replace' ]; then
  awk 'index($0, "backend/") == 1 || index($0, "system-static/") == 1 || $0 == "backend" || $0 == "system-static" { next } { exit 1 }' "$archive_list"
elif [ "$employee_static_mode" = 'replace' ] && [ "$system_static_enabled" = 'true' ] && [ "$system_static_mode" = 'replace' ]; then
  awk 'index($0, "backend/") == 1 || index($0, "static/") == 1 || index($0, "system-static/") == 1 || $0 == "backend" || $0 == "static" || $0 == "system-static" { next } { exit 1 }' "$archive_list"
else
  awk 'index($0, "backend/") == 1 || index($0, "static/") == 1 || $0 == "backend" || $0 == "static" { next } { exit 1 }' "$archive_list"
fi
awk '$0 ~ /^\// || $0 ~ /(^|\/)\.\.($|\/)/ || $0 ~ /\\/ { exit 1 }' "$archive_list"
