  "http://127.0.0.1:3001$probe_path")"
api_status="${api_result%%$'\n'*}"
api_content_type="${api_result#*$'\n'}"
probe_status_matches "$probe_expected_status" "$api_status"
case "$api_content_type" in application/json*) ;; *) false ;; esac
! grep -qi -- '<html' "$api_body"
[ "$(curl --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/ 2>/dev/null || true)" = '200' ]
[ "$(curl --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/projects/1/asr 2>/dev/null || true)" = '200' ]
if [ "$system_static_enabled" = 'true' ]; then
  [ "$(curl --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8081/ 2>/dev/null || true)" = '200' ]
  [ "$(curl --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8081/budgets 2>/dev/null || true)" = '200' ]
fi
if [ "$employee_static_mode" = 'preserve' ]; then
  employee_static_preserve_guard preserve "$old_static" "$static_stage" "$STATIC_LINK" "$STATIC_NEXT"
fi
echo "post_switch=passed health:200 unauth_${probe_label}:${probe_expected_status}/json/nonhtml employee:200/200 employee_static:$employee_static_mode system_static:$system_static_mode backend:$candidate_backend_state/stable_pid_5s asr:$old_asr_state screen:$old_screen_state openvino:$old_openvino_state"

failure_code='FINAL_CLEANUP_FAILED'
cleanup_inbound
safe_remove "$RUNTIME"
runtime_created=0
[ ! -e "$inbound" ] && [ ! -e "$RUNTIME" ]
[ ! -e "$CURRENT_NEXT" ] && [ ! -e "$STATIC_NEXT" ] && [ ! -e "$SYSTEM_STATIC_NEXT" ]
[ ! -e "$release_stage" ]
if [ "$employee_static_mode" = 'replace' ]; then
  [ ! -e "$static_stage" ]
else
  employee_static_preserve_guard preserve "$old_static" "$static_stage" "$STATIC_LINK" "$STATIC_NEXT"
fi
if [ "$system_static_enabled" = 'true' ]; then
  if [ "$system_static_mode" = 'replace' ]; then
    [ ! -e "$system_static_stage" ]
  else
    system_static_preserve_guard preserve "$old_system_static" "$system_static_stage" "$new_system_static" "$SYSTEM_STATIC_LINK" "$SYSTEM_STATIC_NEXT"
  fi
fi
trap - ERR EXIT INT TERM
db_write=0
if [ "$migration_mode" = 'gated' ]; then db_write=1; fi
echo "terminal=passed release:$new_release static:$new_static employee_static:$employee_static_mode system_static:$system_static_mode system_static_target:$new_system_static backend_restart:1 db_write:$db_write migration:$migration_mode schema_retained:$schema_retained cos_write:0 route_write:0 budget_write:0 provider_calls:0 asr_restart:0 openvino_restart:0 screen_start:0"
exit 0
