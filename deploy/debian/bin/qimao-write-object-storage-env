#!/bin/sh
# 只接受标准输入中的单行凭据；不得把值放进命令行、日志或仓库。
set -eu

config_dir=/etc/qimao-terms-cloud
target="$config_dir/object-storage.env"
pending="$config_dir/.object-storage-access-key.pending"

if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' 'must run as root' >&2
    exit 1
fi

if [ "$#" -ne 1 ]; then
    printf '%s\n' 'usage: qimao-write-object-storage-env stage-access-key|commit-secret-key' >&2
    exit 64
fi

if [ -L "$config_dir" ] || [ -L "$target" ] || [ -L "$pending" ]; then
    printf '%s\n' 'refusing symbolic-link configuration path' >&2
    exit 1
fi

install -d -o root -g qimao -m 0750 "$config_dir"
umask 007

read_single_line() {
    value=''
    IFS= read -r value || [ -n "$value" ] || {
        printf '%s\n' 'empty credential input' >&2
        exit 1
    }
    if IFS= read -r extra; then
        printf '%s\n' 'credential input must be exactly one line' >&2
        exit 1
    fi
    cr=$(printf '\r')
    case "$value" in
        *"$cr") value=${value%"$cr"} ;;
    esac
    case "$value" in
        *"$cr"*)
            printf '%s\n' 'credential input contains an embedded carriage return' >&2
            exit 1
            ;;
    esac
    if [ -z "$value" ]; then
        printf '%s\n' 'empty credential input' >&2
        exit 1
    fi
}

case "$1" in
    stage-access-key)
        if [ -e "$pending" ] || [ -e "$target" ]; then
            printf '%s\n' 'refusing to overwrite existing object-storage configuration state' >&2
            exit 1
        fi
        read_single_line
        temp=$(mktemp "$config_dir/.object-storage-access-key.XXXXXX")
        trap 'rm -f "$temp"' EXIT HUP INT TERM
        chown root:qimao "$temp"
        chmod 0640 "$temp"
        printf '%s' "$value" > "$temp"
        mv -f "$temp" "$pending"
        trap - EXIT HUP INT TERM
        ;;
    commit-secret-key)
        if [ ! -f "$pending" ] || [ -L "$pending" ] || [ -e "$target" ]; then
            printf '%s\n' 'missing pending access key or target already exists' >&2
            exit 1
        fi
        read_single_line
        access_key=$(cat "$pending")
        if [ -z "$access_key" ]; then
            printf '%s\n' 'pending access key is empty' >&2
            exit 1
        fi
        temp=$(mktemp "$config_dir/.object-storage.env.XXXXXX")
        trap 'rm -f "$temp"' EXIT HUP INT TERM
        chown root:qimao "$temp"
        chmod 0640 "$temp"
        {
            printf '%s\n' 'QIMAO_UPLOAD_STORAGE_KIND=s3'
            printf '%s\n' 'QIMAO_S3_ENDPOINT=https://cn-nb1.rains3.com'
            printf '%s\n' 'QIMAO_S3_BUCKET=milaidi'
            printf '%s\n' 'QIMAO_S3_REGION=cn-nb1'
            printf '%s\n' "QIMAO_S3_ACCESS_KEY_ID=$access_key"
            printf '%s\n' "QIMAO_S3_SECRET_ACCESS_KEY=$value"
            printf '%s\n' 'QIMAO_S3_PRESIGN_TTL_SECONDS=900'
        } > "$temp"
        mv -f "$temp" "$target"
        rm -f "$pending"
        trap - EXIT HUP INT TERM
        ;;
    *)
        printf '%s\n' 'usage: qimao-write-object-storage-env stage-access-key|commit-secret-key' >&2
        exit 64
        ;;
esac
