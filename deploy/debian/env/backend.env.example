# qimao-terms-cloud Debian 12 后端示例环境。
# 复制到 /etc/qimao-terms-cloud/backend.env 后由 root 编辑；本文件不含真实凭据。
# 权限要求：root:root 0640，服务账户只读。

NODE_ENV=production
PORT=3001

# 只允许本机 PostgreSQL；密码通过服务器上的受保护环境文件或 .pgpass 注入。
# 不要把真实密码、Secret、对象存储令牌或供应商凭据提交到仓库。
DATABASE_URL=postgresql://qimao_backend:CHANGE_ME@127.0.0.1:5432/qimao_terms_cloud

# systemd StateDirectory 创建的专属本机持久对象根；父目录可保留其他 root-only 审计状态。
# 不得改为仓库路径、符号链接或公网挂载。
QIMAO_STORAGE_ROOT=/var/lib/qimao-terms-cloud/storage

# UPLOAD-COS-SERVER-05：以下仅为键名/占位，不得把真实 COS 凭据提交到仓库。
# 腾讯 COS 候选固定为 private + browser_direct multipart；Secret 必须另存为
# root:root 0640 的 /etc/qimao-terms-cloud/object-storage.env，并由 systemd 注入。
QIMAO_UPLOAD_STORAGE_KIND=<s3>
QIMAO_S3_PROVIDER=<tencent-cos>
QIMAO_S3_REGION=<ap-nanjing>
QIMAO_S3_BUCKET=<private-cos-bucket>
QIMAO_S3_ACCESS_KEY_ID=<root-only-access-key-id>
QIMAO_S3_SECRET_ACCESS_KEY=<root-only-secret-access-key>
QIMAO_S3_PRESIGN_TTL_SECONDS=<600>
QIMAO_S3_UPLOAD_MODE=<browser_direct>
QIMAO_DIRECT_UPLOAD_ORIGIN=<https-origin>

# 腾讯云 ASR 仅供后端 Worker 使用；默认不启用，必须由 root-only 环境显式开启。
# QIMAO_TENCENT_ASR_ENABLED
# QIMAO_TENCENT_ASR_REGION
# QIMAO_TENCENT_ASR_SECRET_ID
# QIMAO_TENCENT_ASR_SECRET_KEY
# QIMAO_TENCENT_ASR_OBJECT_URL_TTL_SECONDS

# 腾讯 GeneralBasicOCR 仅供后端画面字 Worker 使用；默认关闭，缺失/半配置 fail-closed。
# 独立于 ASR/COS Secret，禁止写入浏览器或日志。
# QIMAO_TENCENT_OCR_ENABLED
# QIMAO_TENCENT_OCR_REGION
# QIMAO_TENCENT_OCR_SECRET_ID
# QIMAO_TENCENT_OCR_SECRET_KEY
# QIMAO_TENCENT_OCR_TIMEOUT_MS
# QIMAO_TENCENT_OCR_MAX_AMOUNT_CNY  （显式正数上限；启用时必填，禁止零成本报价）
# 服务器提供的有界抽帧可执行文件；缺失或二进制未配置时 Worker fail-closed。
# frame-extractor.js 使用固定 shebang，发布时保留可执行权限；ffprobe/ffmpeg 均须绝对路径。
# QIMAO_SCREEN_TEXT_FRAME_EXTRACTOR_BIN=/opt/qimao/sidecars/local-ocr/frame-extractor.js
# QIMAO_SCREEN_TEXT_FFPROBE_BIN=/usr/bin/ffprobe
# QIMAO_SCREEN_TEXT_FFMPEG_BIN=/usr/bin/ffmpeg

# 本地 PP-OCRv6 Small（默认关闭；仅 loopback endpoint，模型摘要必须由服务器显式提供）。
# 两个 Provider 共用同一模型摘要，主备顺序由既有 routing policy 决定，不在 adapter 内 fallback。
# QIMAO_LOCAL_OCR_PP_OCRV6_SMALL_MODEL_DIGEST=<sha256-64-hex>
# QIMAO_LOCAL_OCR_OPENVINO_ENABLED=true|false
# QIMAO_LOCAL_OCR_OPENVINO_ENDPOINT=http://127.0.0.1:<port>/ocr
# QIMAO_LOCAL_OCR_OPENVINO_TIMEOUT_MS=<100..120000>
# QIMAO_LOCAL_OCR_ONNX_ENABLED=true|false
# QIMAO_LOCAL_OCR_ONNX_ENDPOINT=http://127.0.0.1:<port>/ocr
# QIMAO_LOCAL_OCR_ONNX_TIMEOUT_MS=<100..120000>

# Cloudflare Access（占位；不要写入真实邮箱、AUD、JWT 或 Secret）。
# QIMAO_ACCESS_REQUIRED=true 时仅管理员 control issuer/AUD/邮箱白名单必须配置。
QIMAO_ACCESS_REQUIRED=true
QIMAO_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
QIMAO_ACCESS_CONTROL_AUDIENCE=<control-application-aud>
QIMAO_ACCESS_CONTROL_EMAIL_ALLOWLIST=<owner@example.invalid>

# 员工站共享测试账号：密码不写入环境文件，只保存版本化 scrypt verifier。
# 会话 Secret 必须为至少 32 字节的 base64url 随机值；Cookie 固定 14 天、HttpOnly、Secure、SameSite=Lax。
QIMAO_EMPLOYEE_SESSION_REQUIRED=true
QIMAO_EMPLOYEE_AUTH_USERNAME=<employee-test-username>
QIMAO_EMPLOYEE_PASSWORD_VERIFIER=scrypt-v1$N=16384$r=8$p=1$<salt-base64url>$<digest-base64url>
QIMAO_EMPLOYEE_SESSION_SECRET=<at-least-32-random-bytes-base64url>
QIMAO_EMPLOYEE_ORIGIN=https://work.example.invalid

# Secret/provider 仍需另行获批并由服务器端注入；不得写入本文件或浏览器。
