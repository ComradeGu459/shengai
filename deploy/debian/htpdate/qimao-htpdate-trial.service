[Unit]
Description=Qimao trial-only HTTP consensus time adjustment
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/libexec/qimao-htpdate-trial

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/qimao-htpdate-trial
LogsDirectory=qimao-htpdate-trial
LogsDirectoryMode=0700
StateDirectory=qimao-htpdate-trial
StateDirectoryMode=0700
RuntimeDirectory=qimao-htpdate-trial
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME
UMask=0077
TimeoutStartSec=4min

[Install]
WantedBy=multi-user.target
