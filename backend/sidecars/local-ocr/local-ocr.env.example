# 默认关闭；启用前必须由服务器提供已安装的本地 RapidOCR runner 与模型目录。
QIMAO_LOCAL_OCR_SIDECAR_ENABLED=false
# 只能是 openvino 或 onnxruntime；两套进程必须使用同一模型摘要和模型包目录内容。
QIMAO_LOCAL_OCR_SIDECAR_BACKEND=openvino
QIMAO_LOCAL_OCR_SIDECAR_HOST=127.0.0.1
QIMAO_LOCAL_OCR_SIDECAR_PORT=19000
# 仅用于首次加载本地 RapidOCR/ONNX 模型；请求超时仍由下方有界 timeout 控制。
QIMAO_LOCAL_OCR_SIDECAR_STARTUP_TIMEOUT_MS=300000
QIMAO_LOCAL_OCR_SIDECAR_TIMEOUT_MS=60000
QIMAO_LOCAL_OCR_PP_OCRV6_SMALL_MODEL_DIGEST=<sha256-64-hex>
QIMAO_LOCAL_OCR_PP_OCRV6_SMALL_MODEL_DIR=/opt/qimao/models/ppocrv6-small
QIMAO_LOCAL_OCR_SIDECAR_RUNNER_EXECUTABLE=/usr/bin/python3
QIMAO_LOCAL_OCR_SIDECAR_RUNNER_SCRIPT=/opt/qimao/sidecars/local-ocr/paddle_hpi_runner.py
# 有界视频抽帧 sidecar；三个可执行路径均须为服务器上的绝对路径，缺失时 Worker fail-closed。
QIMAO_SCREEN_TEXT_FRAME_EXTRACTOR_BIN=/opt/qimao/sidecars/local-ocr/frame-extractor.js
QIMAO_SCREEN_TEXT_FFPROBE_BIN=/usr/bin/ffprobe
QIMAO_SCREEN_TEXT_FFMPEG_BIN=/usr/bin/ffmpeg
# runner 使用 RapidOCR 3.9.1 直载本地 PP-OCRv6 Small ONNX：
# <model-dir>/PP-OCRv6_small_det/*.onnx、<model-dir>/PP-OCRv6_small_rec/*.onnx
# 与 ch_ppocr_mobile_v2.0_cls_mobile.onnx；不得自动下载、换模型或内部 fallback。
