{
  "name": "@qimao-terms-cloud/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/development.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:asr-worker": "tsx watch src/workers/asr.worker.entry.ts",
    "dev:pre-review-worker": "tsx watch src/workers/pre-review.worker.entry.ts",
    "dev:screen-text-worker": "tsx watch src/workers/screen-text.worker.entry.ts",
    "start": "tsx src/server.ts",
    "start:asr-worker": "tsx src/workers/asr.worker.entry.ts",
    "start:pre-review-worker": "tsx src/workers/pre-review.worker.entry.ts",
    "start:screen-text-worker": "tsx src/workers/screen-text.worker.entry.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "@qimao-terms-cloud/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.11.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
