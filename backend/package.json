{
  "name": "@qimao-terms-cloud/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "pnpm --filter @qimao-terms-cloud/contracts run build",
    "build:sidecars": "tsc -p tsconfig.sidecars.build.json && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/sidecars/local-ocr/frame-extractor.js', 0o755)\"",
    "dev": "pnpm run build:contracts && tsx watch src/development.ts",
    "dev:api": "pnpm run build:contracts && tsx watch src/server.ts",
    "dev:asr-worker": "pnpm run build:contracts && tsx watch src/workers/asr.worker.entry.ts",
    "dev:pre-review-worker": "pnpm run build:contracts && tsx watch src/workers/pre-review.worker.entry.ts",
    "dev:screen-text-worker": "pnpm run build:contracts && tsx watch src/workers/screen-text.worker.entry.ts",
    "dev:term-extraction-worker": "pnpm run build:contracts && tsx watch src/workers/term-extraction.worker.entry.ts",
    "dev:strategy-worker": "pnpm run build:contracts && tsx watch src/workers/system-control.strategy.worker.entry.ts",
    "start": "pnpm run build:contracts && tsx src/server.ts",
    "start:asr-worker": "pnpm run build:contracts && tsx src/workers/asr.worker.entry.ts",
    "start:pre-review-worker": "pnpm run build:contracts && tsx src/workers/pre-review.worker.entry.ts",
    "start:screen-text-worker": "pnpm run build:contracts && tsx src/workers/screen-text.worker.entry.ts",
    "start:term-extraction-worker": "pnpm run build:contracts && tsx src/workers/term-extraction.worker.entry.ts",
    "start:local-ocr-sidecar": "node dist/sidecars/local-ocr/entry.js",
    "start:screen-text-frame-extractor": "node dist/sidecars/local-ocr/frame-extractor.js",
    "start:strategy-worker": "pnpm run build:contracts && tsx src/workers/system-control.strategy.worker.entry.ts",
    "start:project-cleanup-worker": "pnpm run build:contracts && tsx src/workers/project-cleanup.worker.entry.ts",
    "start:upload-completion-worker": "pnpm run build:contracts && tsx src/workers/upload-completion.worker.entry.ts",
    "db:migrate": "pnpm run build:contracts && tsc -p tsconfig.build.json && node dist/database/migrate.js",
    "build": "pnpm run build:contracts && tsc -p tsconfig.build.json && pnpm run build:sidecars",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@qimao-terms-cloud/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.4",
    "fastify": "5.11.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "typebox": "1.3.12",
    "tencentcloud-sdk-nodejs-asr": "^4.1.298",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.302"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
